# Webcam index, an RTSP URL, or a video file path.
CAMERA_SOURCE=0
# Maximum processed frames per second for a live camera.
TARGET_FPS=30
# Requested capture size for a live camera.
FRAME_WIDTH=1280
# Requested capture size for a live camera.
FRAME_HEIGHT=720
# Seconds of corroborated pose plus glint before PIRACY_ALERT.
PIRACY_THRESHOLD_SEC=30
# YOLO pose confidence cutoff.
CONF_THRESHOLD=0.65
# Seconds to wait on a stuck camera read.
IO_TIMEOUT=5
# off, simulated, or real. simulated is not a real NIR camera.
NIR_MODE=simulated
# Replay a video file from the start when it ends.
LOOP_VIDEO=true
# File playback speed from 0.25 to 4. Ignored by the scenario runner, which does not pace.
PLAYBACK_SPEED=1.0
# Leave empty for dev mode. When set, POST/PUT/DELETE and evidence require this bearer token.
API_TOKEN=
# Reserved for scripted demos.
DEMO_MODE=false
# Local pose weights. The app does not download this file.
POSE_MODEL_PATH=models/yolov8n-pose.pt
# When true, NIR off can still reach PIRACY_ALERT. The score is otherwise capped.
ALLOW_POSE_ONLY_ALERT=false
# Largest timestamp gap counted as active time, so a seek cannot add minutes.
MAX_FRAME_DT=1
# How long a lost alert track is kept before it is closed.
ALERT_GRACE_SEC=2
# Two arms raised for less than this many seconds are labeled stretching.
STRETCH_BRIEF_S=2
# Reuse an incident for the same seat inside this many seconds.
INCIDENT_MERGE_WINDOW_S=120
# After a false-positive review, ignore that seat for this many frame-timestamp seconds.
SUPPRESS_AFTER_DISMISS_S=60
# Clean frames kept before an incident starts.
PREROLL_S=8
# Clean frames kept after an incident ends.
POSTROLL_S=5
# Longest evidence clip.
CLIP_MAX_S=30
# Delete evidence directories older than this many days.
EVIDENCE_RETENTION_DAYS=7
# Directory for keyframes and clips.
EVIDENCE_DIR=evidence
# SQLite incident database.
DB_PATH=data/cineguard.db
# Saved seat-grid corners. Missing file means the uncalibrated 4x10 grid.
CALIBRATION_PATH=data/auditorium.json
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Largest accepted JSON body on POST, PUT, and DELETE.
MAX_BODY_BYTES=1048576
# Mutating requests allowed per client address each minute. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=120
